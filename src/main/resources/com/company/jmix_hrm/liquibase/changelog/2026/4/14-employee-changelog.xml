<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="1" author="Jayesh">
        <createTable tableName="EMPLOYEE">

            <column name="EMPLOYEE_ID" type="uuid">
                <constraints primaryKey="true"/>
            </column>

            <column name="EMPLOYEE_CODE" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="DATE_OF_BIRTH" type="datetime"/>

            <column name="DEPARTMENT_ID" type="uuid"/>

            <column name="USER_ID" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="CREATED_BY" type="VARCHAR(255)"/>

            <column name="CREATED_AT" type="TIMESTAMP"/>

            <column name="UPDATED_BY" type="VARCHAR(255)"/>

            <column name="UPDATED_AT" type="TIMESTAMP"/>

            <column name="VERSION" type="integer"/>

        </createTable>

        <addForeignKeyConstraint baseTableName="EMPLOYEE" baseColumnNames="DEPARTMENT_ID"
                                 constraintName="FK_DEPARTMENT_EMPLOYEE"
                                 referencedTableName="DEPARTMENT"
                                 referencedColumnNames="DEPARTMENT_ID"/>

        <addForeignKeyConstraint baseTableName="EMPLOYEE" baseColumnNames="USER_ID" constraintName="FK_USER_EMPLOYEE"
                                 referencedTableName="USER_"
                                 referencedColumnNames="ID"/>

    </changeSet>

    <changeSet id="2" author="Jayesh">
        <modifyDataType tableName="EMPLOYEE" columnName="DATE_OF_BIRTH" newDataType="date"/>
    </changeSet>

    <changeSet id="3" author="Sameet">
        <addColumn tableName="EMPLOYEE">
            <column name="GENDER" type="varchar(255)"/>
        </addColumn>
        <addColumn tableName="EMPLOYEE">
            <column name="DESIGNATION" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="5" author="Jayesh">
        <addColumn tableName="EMPLOYEE">
            <column name="MANAGER_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="EMPLOYEE" baseColumnNames="MANAGER_ID"
                                 constraintName="FK_EMPLOYEE_MANAGER"
                                 referencedTableName="EMPLOYEE"
                                 referencedColumnNames="EMPLOYEE_ID"/>
    </changeSet>

    <changeSet id="6" author="Jayesh">
        <addColumn tableName="employee">
            <column name="profile_picture" type="varchar(1024)"/>
        </addColumn>
    </changeSet>

    <changeSet id="7" author="jmix_hrm">
        <dropColumn tableName="EMPLOYEE" columnName="PROFILE_PICTURE" />
        <addColumn tableName="EMPLOYEE">
            <column name="PROFILE_PICTURE"
                    type="blob"/>
        </addColumn>
    </changeSet>
    
    <changeSet id="8" author="Jayesh">
        <dropColumn tableName="EMPLOYEE" columnName="PROFILE_PICTURE" />
        <addColumn tableName="EMPLOYEE">
            <column name="PROFILE_PICTURE"
                    type="bytea"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>